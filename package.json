{
  "name": "smartcareer-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run start:dev --workspace=@smartcareer/api",
    "dev:web": "npm run dev --workspace=@smartcareer/web",
    "start:api": "npm run start:dev --workspace=@smartcareer/api",
    "start:web": "npm run dev --workspace=@smartcareer/web",
    "build": "npm run build --workspace=@smartcareer/shared && npm run prisma:generate && npm run build:app --workspace=@smartcareer/api && npm run build:app --workspace=@smartcareer/web",
    "build:web": "npm run build --workspace=@smartcareer/web",
    "build:api": "npm run build --workspace=@smartcareer/api",
    "lint": "npm run lint --workspace=@smartcareer/web",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "prisma:seed:prod": "npx ts-node prisma/seed-production.ts",
    "prisma:studio": "npx prisma studio",
    "admin:create": "npx ts-node scripts/create-superadmin.ts",
    "test": "npm run test:security && npm run test:uat",
    "test:uat": "node --test tests/uat-fixes.spec.cjs",
    "test:security": "node --test tests/security.spec.cjs",
    "test:regression": "node scripts/verify-core-regression.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "dompurify": "^3.4.16",
    "qs": "^6.16.0",
    "body-parser": "^1.20.6",
    "file-type": "^21.3.2",
    "uuid": "^11.1.1"
  }
}
