# =================================================================
# SmartCareer Production Environment Configuration Template
# =================================================================
# Security Notice:
# 1. Do NOT commit the actual .env.production file to version control.
# 2. Generate cryptographically strong random secrets for JWT_SECRET and Database passwords.
# 3. All URLs must use HTTPS on production.
# =================================================================

# Server Runtime
NODE_ENV=production
PORT=4000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/smartcareer?schema=public&sslmode=prefer"
POSTGRES_DB=smartcareer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# JWT Authentication (Generate via: openssl rand -base64 32)
JWT_SECRET="REPLACE_WITH_STRONG_64_CHAR_RANDOM_SECRET_KEY"
JWT_EXPIRES_IN="7d"

# Frontend & API Networking (Fail-Closed CORS)
FRONTEND_URL="https://smartcareer.yourdomain.com"
NEXT_PUBLIC_API_URL="https://api.smartcareer.yourdomain.com/api"
ALLOWED_ORIGINS="https://smartcareer.yourdomain.com"

# Demo UI & Dev Auth (Fail-Closed default: false)
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
ENABLE_DEV_MOCK_AUTH="false"
ALLOW_PRODUCTION_SEED="false"

# Production Superadmin Initial Credentials (Required only for scripts/create-superadmin.ts)
# ADMIN_EMAIL="admin@yourdomain.com"
# ADMIN_PASSWORD="ReplaceWith12+CharStrongPassword!"

# Google OAuth 2.0 (Registered with Production Domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api.smartcareer.yourdomain.com/api/auth/google/callback"

# GitHub OAuth App (Registered with Production Domain)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="https://api.smartcareer.yourdomain.com/api/auth/github/callback"
GITHUB_TOKEN=""

# AI & External Code Assessment Engine
GEMINI_API_KEY=""
JUDGE0_BASE_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
RAPIDAPI_KEY=""

# Partner & Course Scraper APIs
UDEMY_CLIENT_ID=""
UDEMY_CLIENT_SECRET=""
