{
  "name": "@smartcareer/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --workspace=@smartcareer/shared && npx prisma generate --schema=../../prisma/schema.prisma",
    "build": "nest build",
    "build:app": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
