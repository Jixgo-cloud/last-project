# Environment Configuration
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/smartcareer?schema=public"

# JWT Authentication
JWT_SECRET="smartcareer_super_secret_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# GitHub API (Optional, falls back to public rate limits & mock scenarios)
GITHUB_TOKEN=""

# Judge0 API (Optional, falls back to local sandboxed evaluator)
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# External Job APIs (Optional, falls back to scrapers & seed jobs)
RAPIDAPI_KEY=""
JSEARCH_API_URL="https://jsearch.p.rapidapi.com"

# Udemy Affiliate API (Optional, falls back to live web crawler)
UDEMY_CLIENT_ID=""
UDEMY_CLIENT_SECRET=""
