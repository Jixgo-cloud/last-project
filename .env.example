# Environment Configuration
NODE_ENV=development
PORT=4000
# Bind to loopback for local staging. Default API bind address is 0.0.0.0.
# HOST=127.0.0.1
# Read on startup; false disables scheduled ingestion/cleanup (not in-flight work).
ENABLE_SCHEDULED_JOBS=true
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/smartcareer?schema=public"

# JWT Authentication
JWT_SECRET="" # Generate a unique random value of at least 32 characters before starting.
JWT_EXPIRES_IN="7d"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Optional directory for saved ingestion settings (absolute path recommended).
# Default: apps/api/config, independent of the API working directory.
# INGESTION_CONFIG_DIR=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# GitHub API (Optional, falls back to public rate limits & mock scenarios)
GITHUB_TOKEN=""

# Judge0 API (required for execution; no local evaluator fallback)
JUDGE0_BASE_URL="https://ce.judge0.com" # Configure a dedicated Judge0 provider for production capacity.
JUDGE0_API_KEY=""

# AI assessment and extraction (optional)
GEMINI_API_KEY=""

# JSearch: dedicated key takes precedence; RAPIDAPI_KEY is a legacy fallback.
# Missing credentials or unavailable providers preserve existing jobs and report an error.
JSEARCH_API_KEY=""
RAPIDAPI_KEY=""
JSEARCH_API_URL="https://jsearch.p.rapidapi.com"

# Udemy Affiliate API (Optional, falls back to live web crawler)
UDEMY_CLIENT_ID=""
UDEMY_CLIENT_SECRET=""

# YouTube Data API v3 (server only). Empty/unavailable uses the existing catalog.
YOUTUBE_API_KEY=
